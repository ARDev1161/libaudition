@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@LIBAUDITION_WITH_SPDLOG@)
    find_dependency(spdlog 1.15 CONFIG)
endif()

if(@LIBAUDITION_WITH_ODAS@)
    set(_libaudition_saved_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(ODAS)
    set(CMAKE_MODULE_PATH "${_libaudition_saved_module_path}")
    unset(_libaudition_saved_module_path)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/libauditionTargets.cmake")
check_required_components(libaudition)
