# Public C++ API reference: XML for Breathe + standalone navigable HTML.
# Both formats are derived from the same public headers.
# Run from the repository root: doxygen docs/Doxyfile.pages
PROJECT_NAME           = libaudition
PROJECT_BRIEF          = "Composable C++17 acoustic perception toolkit"
OUTPUT_DIRECTORY       = docs/_build
INPUT                  = include
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
GENERATE_HTML          = YES
HTML_OUTPUT             = doxygen
GENERATE_TREEVIEW       = YES
SEARCHENGINE            = YES
SERVER_BASED_SEARCH     = NO
GENERATE_XML           = YES
GENERATE_LATEX         = NO
XML_OUTPUT             = xml
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
JAVADOC_AUTOBRIEF      = YES
FULL_PATH_NAMES        = YES
HAVE_DOT               = NO
